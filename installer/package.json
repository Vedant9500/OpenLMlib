{
  "name": "openlmlib",
  "version": "0.2.8",
  "description": "Local knowledge and research library for LLM workflows — CLI plus a 76-tool MCP server for AI assistants",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "openlmlib": "bin/openlmlib.js"
  },
  "preferGlobal": true,
  "files": [
    "bin/",
    "src/",
    "openlmlib/",
    "pyproject.toml"
  ],
  "scripts": {
    "bundle": "node bundle-python.js",
    "prepack": "node bundle-python.js && node scripts/verify-package.mjs",
    "postpack": "node bundle-python.js --cleanup",
    "postinstall": "node src/postinstall.mjs",
    "verify": "node bundle-python.js && node scripts/verify-package.mjs",
    "dev": "node src/cli.js",
    "build": "echo 'No build step — src runs directly with Node.js'"
  },
  "keywords": [
    "ai",
    "llm",
    "knowledge-base",
    "mcp",
    "retrieval",
    "embeddings",
    "rag",
    "cli",
    "collaboration",
    "multi-agent",
    "autonomous"
  ],
  "author": "OpenLMlib Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vedant9500/OpenLMlib.git",
    "directory": "installer"
  },
  "homepage": "https://github.com/Vedant9500/OpenLMlib#readme",
  "bugs": {
    "url": "https://github.com/Vedant9500/OpenLMlib/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.3.0",
    "figures": "^6.0.0",
    "ink": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ora": "^8.1.0",
    "react": "^18.3.0"
  }
}
